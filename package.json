{
	"name": "relay-loop",
	"version": "0.1.0",
	"private": true,
	"description": "In-place context relay for pi sessions: nudges as the context fills, resets it in place on request (same session, fresh context that opens with a deterministic catch-up), and an optional keep-going loop",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit && bun test",
		"e2e": "bun e2e/run.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@types/bun": "^1.4.3",
		"@types/node": "22",
		"typebox": "1.3.27",
		"typescript": "5"
	}
}
